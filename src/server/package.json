{
  "name": "naruto-login-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch index.ts --dev",
    "typecheck": "tsc -p ../../tsconfig.json --noEmit",
    "build": "vite build --ssr index.ts --outDir dist && node mcp/copy-skills.mjs",
    "start": "node dist/index.js",
    "test": "tsx --test ../../tests/*.test.ts"
  },
  "dependencies": {
    "@alicloud/openapi-core": "1.0.8",
    "@alicloud/sls20201230": "5.12.0",
    "@darabonba/typescript": "1.0.5",
    "@mastra/core": "1.82.0",
    "@mastra/mcp": "2.8.0",
    "ali-oss": "^6.23.0",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/ali-oss": "^6.23.3",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
