{
  "name": "naruto-login-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts --dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && vite build --ssr src/server/index.ts",
    "start": "node dist-server/index.js",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
