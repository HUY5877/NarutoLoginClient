{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": { "@/*": ["./src/frontend/*"] },
    "noEmit": true,
    "types": ["node"],
    "typeRoots": ["./src/server/node_modules/@types", "./src/frontend/node_modules/@types"]
  },
  "include": ["src", "tests"]
}
