# 从项目根目录启动。默认与 NarutoDailyADB/login-service 的本地配置配对。
HOST=127.0.0.1
PORT=4300
LOGIN_SERVICE_URL=http://127.0.0.1:4320
SERVICE_TOKEN=local-development-token
SESSION_TTL_MS=120000
UPSTREAM_TIMEOUT_MS=5000

# local: 通过任务服务的模拟 OSS HTTP 接口读对象；oss: 直接访问阿里云 OSS。
STORAGE_DRIVER=local
OSS_KEY_PREFIX=login
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_STS_TOKEN=

# 开发 Vite 代理会保留浏览器 Origin；生产同源请求自动允许。
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
