# 页面无需 .env 即可启动；注册需要 PostgreSQL，登录还需 JWT_SECRET，申请二维码需要 Redis。
# DATABASE_URL=postgresql://username:password@host:5432/database
# JWT_SECRET 仅供后端签名；生成一次后保存，所有后端实例使用同一值。
# 可用 node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))" 生成。
# JWT_SECRET=
# Redis 尚未提供时保持 REDIS_URL 未配置，不要填写伪地址。
# REDIS_URL 支持 redis:// 或 rediss://，填写可访问实例的真实连接信息。
# REDIS_URL=

# 本地模拟存储，直接读取仓库 .data/login-objects/<前缀>/<id>/qr.png。
STORAGE_DRIVER=local

# Vercel 使用 OSS：将上方改为 oss，并填写下面四项。
# Python 写入端使用相同地域、Bucket 和前缀，凭据可独立配置。
# OSS_REGION=oss-cn-shanghai
# OSS_BUCKET=your-private-bucket
# OSS_ACCESS_KEY_ID=your-access-key-id
# OSS_ACCESS_KEY_SECRET=your-access-key-secret
# 临时凭证可选：OSS_STS_TOKEN=

# 以下均有默认值，通常无需设置。
# REDIS_QUEUE_KEY=naruto:login:tasks
# OSS_KEY_PREFIX=login
# REQUEST_TIMEOUT_MS=5000
# SESSION_TTL_MS=120000
# LOCAL_OBJECTS_DIR=E:/code/NarutoLoginClient/.data/login-objects
